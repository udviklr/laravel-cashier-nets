{
    "name": "udviklr/laravel-cashier-nets",
    "description": "Laravel Cashier-inspired subscription billing for Nets Easy.",
    "keywords": [
        "laravel",
        "cashier",
        "nets",
        "nexi",
        "billing",
        "subscriptions"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Magnus Flor",
            "email": "magnus@udviklr.dk"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.67|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.36|^9.15|^10.8|^11.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Udviklr\\CashierNets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Udviklr\\CashierNets\\CashierNetsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/phpunit --exclude-group integration",
        "test:integration": "@php vendor/bin/phpunit --group integration",
        "test:integration:charges": "@php vendor/bin/phpunit --group nets-charge",
        "analyse": "@php vendor/bin/phpstan analyse --debug --ansi"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
